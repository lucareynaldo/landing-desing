---
import Marquee from "./Marquee.astro";
import { filasDelHero } from "../data/trabajos";

// Composicion del hero tomada de readymag.com.
//
// Tres decisiones que vienen del original y que importan:
//  1. Todos los tiles tienen la misma proporcion. El tamaño lo define la fila,
//     que va DECRECIENDO de arriba hacia abajo.
//  2. El titular entra en UN SOLO renglon en desktop y apenas asoma al pie del
//     viewport. No es un descuido: es lo que empuja a scrollear.
//  3. Las filas CRECEN en escala a medida que se scrollea, dentro de su banda.

const [fila1, fila2, fila3] = filasDelHero();
---

<section id="trabajos" class="pt-2">
  {/*
    La banda recorta el zoom: las filas crecen dentro de ella y el titular de
    abajo no se mueve. El alto en vh es lo que hace que el titular quede
    justo asomando al pie del viewport en desktop.
  */}
  <div class="hero-banda overflow-hidden" data-hero-banda>
    <div class="hero-filas flex flex-col gap-3 md:gap-4" data-hero-filas>
      <Marquee items={fila1} direction="left" duration={70} height="clamp(120px, 30vh, 350px)" />
      <Marquee items={fila2} direction="right" duration={85} height="clamp(100px, 24.5vh, 290px)" />
      <Marquee items={fila3} direction="left" duration={60} height="clamp(78px, 17.5vh, 210px)" />
    </div>
  </div>

  {/* --- Titular y boton --- */}
  <div class="mx-auto max-w-[1400px] px-6 pb-20 pt-10 md:px-10 md:pb-32 md:pt-14">
    <h1
      class="type-display text-[clamp(2.25rem,5.1vw,4.9rem)] text-ink-strong md:whitespace-nowrap"
    >
      Diseñamos marcas coherentes y serias
    </h1>

    <div class="mt-8 flex flex-wrap items-center gap-4 md:mt-10">
      <a
        href="#contacto"
        class="group inline-flex items-center gap-3 rounded-full bg-ink-strong px-7 py-4 text-base font-bold tracking-[-0.011em] text-surface transition-transform duration-(--duration-base) ease-(--ease-out) hover:scale-[1.03] md:text-lg"
      >
        Ver cómo trabajamos
        <span
          class="transition-transform duration-(--duration-base) ease-(--ease-out) group-hover:translate-x-1"
          aria-hidden="true">→</span
        >
      </a>
      <p class="type-body max-w-[34ch] text-ink-muted">
        Cada pieza de arriba pertenece a una marca que antes no se parecía a sí misma.
      </p>
    </div>
  </div>
</section>

<style>
  .hero-filas {
    transform: scale(var(--hero-escala, 1));
    transform-origin: 50% 42%;
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-filas {
      transform: none;
    }
  }
</style>

<script>
  // Las filas crecen con el scroll dentro de su banda. rAF-throttled y
  // transform-only, asi que no hay reflow: el trabajo se va al compositor.
  const filas = document.querySelector<HTMLElement>("[data-hero-filas]");
  const banda = document.querySelector<HTMLElement>("[data-hero-banda]");

  if (filas && banda && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const ESCALA_MAX = 1.32;
    let pendiente = false;
    let alto = banda.offsetHeight;

    const pintar = () => {
      pendiente = false;
      // 0 arriba de todo, 1 cuando la banda termino de salir por arriba
      const avance = Math.min(1, Math.max(0, window.scrollY / (alto || 1)));
      filas.style.setProperty("--hero-escala", String(1 + avance * (ESCALA_MAX - 1)));
    };

    const alScrollear = () => {
      if (!pendiente) {
        pendiente = true;
        requestAnimationFrame(pintar);
      }
    };

    window.addEventListener("scroll", alScrollear, { passive: true });
    window.addEventListener(
      "resize",
      () => {
        alto = banda.offsetHeight;
        alScrollear();
      },
      { passive: true },
    );
    pintar();
  }
</script>
