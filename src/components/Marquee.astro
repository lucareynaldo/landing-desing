---
import type { Trabajo } from "../data/trabajos";

// Fila de marquee horizontal. CSS puro: la pista se duplica y se desplaza
// exactamente -50%, con lo que el bucle es continuo sin JS ni saltos.
//
// Los tiles son TODOS de la misma proporcion, como en readymag: la variacion
// de tamaño viene de la fila, no de la pieza. Eso es lo que hace que se lea
// como un sistema y no como un collage.
//
// Cada tile es un <button> que dispara la vista detalle. Solo la primera
// copia de la pista es interactiva: la segunda existe unicamente para cerrar
// el bucle y va marcada como aria-hidden e inerte.

interface Props {
  items: Trabajo[];
  direction?: "left" | "right";
  duration?: number; // segundos por vuelta completa
  height: string; // alto de la fila; lo decide el hero
}

const { items, direction = "left", duration = 60, height } = Astro.props;
const track = [...items, ...items];
---

<div class="marquee group relative overflow-hidden" data-marquee>
  <div
    class="marquee-track flex w-max gap-3 md:gap-4"
    style={`--marquee-duration:${duration}s; --marquee-direction:${
      direction === "left" ? "normal" : "reverse"
    };`}
  >
    {
      track.map((t, i) => {
        const copia = i >= items.length;
        return (
          <button
            type="button"
            class="marquee-item relative m-0 shrink-0 cursor-pointer overflow-hidden rounded-2xl text-left"
            style={`aspect-ratio: 16 / 10; height:${height}; background-color:${t.tono};`}
            data-trabajo={t.slug}
            aria-hidden={copia ? "true" : undefined}
            tabindex={copia ? -1 : undefined}
            aria-label={`Ver ${t.cliente}: ${t.titulo}`}
          >
            {t.media && (
              <img
                src={t.media}
                alt=""
                loading={i < 4 ? "eager" : "lazy"}
                decoding="async"
                class="pointer-events-none absolute inset-0 size-full object-cover"
              />
            )}
            <span class="type-meta absolute bottom-2.5 left-2.5 rounded-full bg-surface/75 px-2 py-1 text-[0.6rem] text-ink backdrop-blur-sm">
              {t.categoria} · {t.cliente}
            </span>
          </button>
        );
      })
    }
  </div>
</div>

<style>
  @keyframes marquee-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  .marquee-track {
    animation: marquee-scroll var(--marquee-duration) linear infinite;
    animation-direction: var(--marquee-direction);
    will-change: transform;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  /* El congelado con el detalle abierto lo hace TrabajoDetalle por JS, no una
     regla de aca: una regla scopeada que dependa de un atributo en <body> es
     fragil (Astro la descarta al combinarla con :global) y ademas acopla este
     componente a otro. */

  /* Hover de imagen medido en readymag: transition filter 100ms ease */
  .marquee-item {
    filter: saturate(1);
    transition:
      filter 100ms ease,
      opacity 180ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .marquee:hover .marquee-item {
    filter: saturate(0.15);
  }
  .marquee .marquee-item:hover {
    filter: saturate(1);
  }
  .marquee-item:focus-visible {
    outline: 2px solid var(--color-ink-strong);
    outline-offset: 3px;
  }

  /* La foto crece apenas dentro del tile, que no se mueve. Duracion mas larga
     que el desaturado (100ms) a proposito: el color reacciona al instante y
     el zoom queda por detras, que es lo que lo hace sentir suave y no brusco. */
  .marquee-item img {
    transform: scale(1);
    transition: transform 500ms var(--ease-out);
  }
  .marquee-item:hover img,
  .marquee-item:focus-visible img {
    transform: scale(1.07);
  }

  /* El tile de origen se esconde mientras su copia flotante hace el morph */
  .marquee-item[data-origen] {
    opacity: 0;
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
    .marquee {
      overflow-x: auto;
    }
  }
</style>
