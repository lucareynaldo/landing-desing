---
import type { Trabajo } from "../data/trabajos";

// Fila de marquee horizontal.
//
// El desplazamiento lo hace una animacion CSS sobre transform, o sea que la
// interpola el compositor: cero trabajo en el hilo principal, ni una lectura
// de layout por frame. Por eso NO se reciclan nodos como haria una lista
// virtualizada; con cinco piezas por fila eso seria cambiar algo gratis por
// algo que cuesta JS en cada frame.
//
// Lo que si hace falta es que la pista sea lo bastante larga. Para que el
// bucle no muestre huecos, el ancho total tiene que cubrir el viewport MAS un
// ciclo completo. Con un numero fijo de copias eso se rompe apenas la
// pantalla es ancha o el usuario hace zoom out, asi que el script de abajo
// mide y clona solo las que hagan falta.
//
// Los tiles son TODOS de la misma proporcion, como en readymag: la variacion
// de tamaño viene de la fila, no de la pieza.

interface Props {
  items: Trabajo[];
  direction?: "left" | "right";
  /** Velocidad en px/s. En px y no en segundos por vuelta para que el ritmo
   *  no cambie cuando cambia el ancho del ciclo. */
  velocidad?: number;
  height: string; // alto de la fila; lo decide el hero
}

const { items, direction = "left", velocidad = 24, height } = Astro.props;
// Dos copias de arranque: es el minimo para que el bucle cierre y es lo que
// se ve si el JS no corre. El script agrega mas si el viewport lo pide.
const track = [...items, ...items];
---

<div
  class="marquee group relative overflow-hidden"
  data-marquee
  data-por-copia={items.length}
  data-velocidad={velocidad}
>
  <div
    class="marquee-track flex w-max gap-3 md:gap-4"
    style={`--marquee-direction:${direction === "left" ? "normal" : "reverse"};`}
  >
    {
      track.map((t, i) => {
        const copia = i >= items.length;
        return (
          <button
            type="button"
            class="marquee-item relative m-0 shrink-0 cursor-pointer overflow-hidden rounded-2xl text-left"
            style={`aspect-ratio: 16 / 10; height:${height}; background-color:${t.tono};`}
            data-trabajo={t.slug}
            aria-hidden={copia ? "true" : undefined}
            tabindex={copia ? -1 : undefined}
            aria-label={`Ver ${t.cliente}: ${t.titulo}`}
          >
            {t.media && (
              <img
                src={t.media}
                alt=""
                loading={i < 4 ? "eager" : "lazy"}
                decoding="async"
                class="pointer-events-none absolute inset-0 size-full object-cover"
              />
            )}
            <span class="type-meta absolute bottom-2.5 left-2.5 rounded-full bg-surface/75 px-2 py-1 text-[0.6rem] text-ink backdrop-blur-sm">
              {t.categoria} · {t.cliente}
            </span>
          </button>
        );
      })
    }
  </div>
</div>

<style>
  /* El destino es exactamente un ciclo, en px, medido por el script. El -50%
     de reserva es lo que aplica si el JS no corre: correcto para las dos
     copias que vienen del servidor. */
  @keyframes marquee-scroll {
    to {
      transform: translateX(var(--ciclo, -50%));
    }
  }

  /* La fila necesita overflow hidden para recortar la pista horizontalmente,
     pero eso tambien recortaba la card al escalar en el hover.
     `overflow-x: hidden` + `overflow-y: visible` no sirve: la spec convierte
     el visible en auto y sigue recortando, ademas de meter scrollbar.
     La salida es agrandar la caja de recorte con padding vertical (el
     overflow recorta en el borde del padding box, no del content box) y
     devolver ese alto con margen negativo, para que el layout no se corra
     ni un pixel. */
  .marquee {
    padding-block: 16px;
    margin-block: -16px;
  }
  /* Al crecer, la card invade la franja de la fila vecina: la fila con hover
     tiene que pintarse por encima. */
  .marquee:hover {
    z-index: 3;
  }

  .marquee-track {
    animation: marquee-scroll var(--dur, 60s) linear infinite;
    animation-direction: var(--marquee-direction);
    will-change: transform;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  /* El congelado con el detalle abierto lo hace TrabajoDetalle por JS, no una
     regla de aca: una regla scopeada que dependa de un atributo en <body> es
     fragil (Astro la descarta al combinarla con :global) y ademas acopla este
     componente a otro. */

  /* Hover de imagen medido en readymag: transition filter 100ms ease */
  .marquee-item {
    filter: saturate(1);
    transform: scale(1);
    transition:
      filter 100ms ease,
      transform 500ms var(--ease-out),
      opacity 180ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .marquee:hover .marquee-item {
    filter: saturate(0.15);
  }
  .marquee .marquee-item:hover {
    filter: saturate(1);
  }
  .marquee-item:focus-visible {
    outline: 2px solid var(--color-ink-strong);
    outline-offset: 3px;
  }

  /* La card entera crece un poco. Duracion mas larga que el desaturado
     (100ms) a proposito: el color reacciona al instante y la escala queda por
     detras, que es lo que lo hace sentir suave y no brusco.
     El z-index la levanta por encima de sus vecinas: si no, la de al lado le
     recorta la esquina al crecer. */
  .marquee-item:hover,
  .marquee-item:focus-visible {
    transform: scale(1.05);
    z-index: 2;
  }

  /* El tile de origen se esconde mientras su copia flotante hace el morph */
  .marquee-item[data-origen] {
    opacity: 0;
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
    .marquee {
      overflow-x: auto;
    }
  }
</style>

<script>
  // Ajusta cuantas copias de la pista hacen falta y a que velocidad va.
  //
  // No hay reciclado de nodos ni calculo por frame: se mide una vez (y en
  // cada resize) y despues la animacion CSS sigue corriendo sola en el
  // compositor. Clonar cinco tiles de mas es mucho mas barato que mover
  // nodos en cada frame, y las imagenes son las mismas: el navegador las
  // descarga una sola vez.
  const filas = document.querySelectorAll<HTMLElement>("[data-marquee]");

  filas.forEach((fila) => {
    const pista = fila.querySelector<HTMLElement>(".marquee-track");
    if (!pista) return;

    const porCopia = Number(fila.dataset.porCopia);
    const velocidad = Number(fila.dataset.velocidad);
    if (!porCopia || !velocidad) return;

    const ajustar = () => {
      const hijos = Array.from(pista.children) as HTMLElement[];
      if (hijos.length < porCopia * 2) return;

      // Ancho exacto de un ciclo: la distancia entre un tile y su gemelo de
      // la copia siguiente. Se mide del layout, asi que ya incluye el gap y
      // cualquier redondeo; no hay que reconstruirlo con aritmetica.
      const ciclo = hijos[porCopia].offsetLeft - hijos[0].offsetLeft;
      if (ciclo <= 0) return;

      // La pista tiene que cubrir el viewport MAS un ciclo entero: recien ahi
      // el punto de reinicio queda siempre fuera de pantalla.
      const necesarias = Math.max(2, Math.ceil(window.innerWidth / ciclo) + 1);
      const actuales = Math.round(hijos.length / porCopia);

      if (necesarias > actuales) {
        const molde = hijos.slice(0, porCopia);
        const frag = document.createDocumentFragment();
        for (let c = actuales; c < necesarias; c++) {
          for (const base of molde) {
            const clon = base.cloneNode(true) as HTMLElement;
            // Las copias se pueden clickear (son las que el usuario ve medio
            // ciclo de cada dos), pero no se anuncian ni se tabulan.
            clon.setAttribute("aria-hidden", "true");
            clon.setAttribute("tabindex", "-1");
            clon.removeAttribute("id");
            frag.appendChild(clon);
          }
        }
        pista.appendChild(frag);
      } else if (necesarias < actuales) {
        for (let k = (actuales - necesarias) * porCopia; k > 0; k--) {
          pista.lastElementChild?.remove();
        }
      }

      pista.style.setProperty("--ciclo", `-${ciclo}px`);
      pista.style.setProperty("--dur", `${(ciclo / velocidad).toFixed(2)}s`);
    };

    ajustar();

    let pendiente = 0;
    window.addEventListener(
      "resize",
      () => {
        clearTimeout(pendiente);
        pendiente = window.setTimeout(ajustar, 150);
      },
      { passive: true },
    );

    // Las filas del hero miden en vh y las fotos pueden cambiar el layout al
    // cargar, asi que conviene remedir cuando termina de asentarse todo.
    window.addEventListener("load", ajustar, { once: true });
  });
</script>
