---
// Una etapa del camino. No sabe que existe un camino: solo se pinta mas o
// menos encendida segun --local, que le llega heredada desde la seccion.

interface Props {
  n: string;
  nombre: string;
  /** Color con el que llega esta etapa, antes de apagarse a tinta. */
  tono: string;
  /** Posicion en la cadena de 20 elementos: define cuando le toca aparecer. */
  indice: number;
  /** Celda del grid en desktop. En movil no se usa: cae por orden del DOM. */
  col: number;
  fila: number;
}

const { n, nombre, tono, indice, col, fila } = Astro.props;
---

<li
  class="proceso-celda proceso-nodo"
  style={`--i:${indice}; --col:${col}; --fila:${fila}; --tono:${tono};`}
>
  <span class="proceso-n type-meta">{n}</span>
  <span class="proceso-nombre type-display">{nombre}</span>
</li>

<style>
  .proceso-nodo {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid;
    border-radius: 0.75rem;
    list-style: none;

    /* El nodo APARECE, no se tiñe. Antes las diez cajas estaban desde el
       principio en gris claro y lo unico que viajaba era el color: con las
       diez a la vista no se leia un recorrido, se leia una grilla que cambiaba
       de tono. */

    /* El doble de rapido que su tramo: el nodo termina de entrar en la primera
       mitad y recien despues arranca el vertice que sale de el. Ese huequito
       es lo que hace que se lean como pasos sueltos y no como una sola cosa
       creciendo sin parar. */
    --entrada: clamp(0, calc(var(--paso, 0) * 2), 1);

    /* El color llega saturado con el frente del camino y se apaga a tinta
       cuando el recorrido sigue. Hay color todo el tiempo, pero nunca diez
       a la vez. */
    --viajero: color-mix(
      in srgb,
      var(--tono),
      var(--color-ink-strong) calc(var(--estela, 0) * 100%)
    );

    opacity: var(--entrada);
    /* Entra apenas achicado. Mas que esto se pelea con el grid: el nodo se ve
       moverse dentro de su celda en vez de aparecer en ella. */
    scale: calc(0.94 + var(--entrada) * 0.06);

    border-color: var(--viajero);
    /* Un lavado de color que se va con la estela, para que el nodo recien
       llegado tenga cuerpo y no solo un borde de color. */
    background: color-mix(
      in srgb,
      var(--color-surface),
      var(--tono) calc((1 - var(--estela, 0)) * 8%)
    );
  }

  .proceso-n {
    color: var(--viajero);
  }

  .proceso-nombre {
    font-size: clamp(0.95rem, 1.25vw, 1.2rem);
    color: var(--color-ink-strong);
  }
</style>
