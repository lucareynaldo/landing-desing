---
// Una etapa del camino. No sabe que existe un camino: solo se pinta mas o
// menos encendida segun --local, que le llega heredada desde la seccion.

interface Props {
  n: string;
  nombre: string;
  /** Color con el que llega esta etapa, antes de apagarse a tinta. */
  tono: string;
  /** Posicion en la cadena de 20 elementos: define cuando le toca aparecer. */
  indice: number;
  /** Celda del grid en desktop. En movil no se usa: cae por orden del DOM. */
  col: number;
  fila: number;
}

const { n, nombre, tono, indice, col, fila } = Astro.props;
---

<li
  class="proceso-celda proceso-nodo"
  style={`--i:${indice}; --col:${col}; --fila:${fila}; --tono:${tono};`}
>
  <span class="proceso-n type-meta">{n}</span>
  <span class="proceso-nombre type-display">{nombre}</span>
</li>

<style>
  .proceso-nodo {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid;
    border-radius: 0.75rem;
    list-style: none;

    /* El nodo APARECE, no se tiñe. Antes las diez cajas estaban desde el
       principio en gris claro y lo unico que viajaba era el color: con las
       diez a la vista no se leia un recorrido, se leia una grilla que cambiaba
       de tono. */

    /* El doble de rapido que su tramo: el nodo termina de entrar en la primera
       mitad y recien despues arranca el vertice que sale de el. Ese huequito
       es lo que hace que se lean como pasos sueltos y no como una sola cosa
       creciendo sin parar. */
    --entrada: clamp(0, calc(var(--paso, 0) * 2), 1);

    /* El color llega saturado con el frente del camino y se apaga a tinta
       cuando el recorrido sigue. Hay color todo el tiempo, pero nunca diez
       a la vez. */
    --viajero: color-mix(
      in srgb,
      var(--tono),
      var(--color-ink-strong) calc(var(--estela, 0) * 100%)
    );

    opacity: var(--entrada);
    /* Entra apenas achicado. Mas que esto se pelea con el grid: el nodo se ve
       moverse dentro de su celda en vez de aparecer en ella. El termino de
       --realce es el hover, que se suma en vez de pisar: si fuera otra regla
       de scale, hacer hover durante la entrada cancelaria la entrada. */
    scale: calc(0.94 + var(--entrada) * 0.06 + var(--realce, 0) * 0.035);

    border-color: var(--viajero);
    /* Un lavado de color que se va con la estela, para que el nodo recien
       llegado tenga cuerpo y no solo un borde de color. */
    background: color-mix(
      in srgb,
      var(--color-surface),
      var(--tono) calc((1 - var(--estela, 0)) * 8%)
    );
  }

  /* El hover devuelve a la etapa el color con el que entro.
     Terminado el recorrido los diez nodos quedan en tinta, asi que recuperar
     su color es lo que hace sentir que cada etapa tiene identidad propia y no
     son diez cajas iguales. Se apoya en --viajero, que ya usan el borde y el
     numero: alcanza con redefinirlo aca y las custom properties se encargan
     de bajarlo a los hijos.

     La media query deja afuera el tactil, donde el hover se queda pegado
     despues de tocar. */
  @media (hover: hover) {
    .proceso-nodo:hover {
      --viajero: var(--tono);
      --realce: 1;
      background: color-mix(in srgb, var(--color-surface), var(--tono) 8%);
    }
  }

  /* La transicion existe SOLO despues del recorrido. La clase la pone el
     script al llegar --p a 1.

     Sin esta condicion la entrada sale pastosa: la animacion reescribe scale,
     background y borde en cada frame, y un nodo entra en ~70ms, o sea menos de
     lo que dura la propia transicion. Cada frame quedaria persiguiendo al
     anterior en vez de dibujar. */
  :global(.listo) .proceso-nodo {
    transition:
      scale var(--duration-base) var(--ease-out),
      background var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out);
  }

  .proceso-n {
    color: var(--viajero);
  }

  :global(.listo) .proceso-n {
    transition: color var(--duration-base) var(--ease-out);
  }

  .proceso-nombre {
    font-size: clamp(0.95rem, 1.25vw, 1.2rem);
    color: var(--color-ink-strong);
  }
</style>
