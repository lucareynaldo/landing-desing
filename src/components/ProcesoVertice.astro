---
// Un tramo de linea entre dos nodos, con una punta de flecha en la llegada.
//
// La linea es un ::before y la flecha un ::after, en vez de ser el <li> mismo,
// para poder centrarlos en la celda sin tocar la caja que ocupa en el grid.
//
// La direccion decide el eje del scale y, sobre todo, el transform-origin: el
// tramo tiene que crecer desde el lado por el que ENTRA la linea. Los de la
// fila del medio, que va de derecha a izquierda, crecen desde la derecha; con
// un origin fijo se dibujarian hacia atras justo en esa fila.

export type Direccion = "derecha" | "izquierda" | "abajo";

interface Props {
  /** Posicion en la cadena de 20 elementos. */
  indice: number;
  direccion: Direccion;
  /** Color del nodo del que SALE este tramo: el color se arrastra detras del
   *  frente y el nodo siguiente entra con uno nuevo. */
  tono: string;
  /** Celda del grid en desktop. En movil no se usa. */
  col: number;
  fila: number;
}

const { indice, direccion, tono, col, fila } = Astro.props;
---

<li
  class="proceso-celda proceso-vertice"
  data-direccion={direccion}
  style={`--i:${indice}; --col:${col}; --fila:${fila}; --tono:${tono};`}
  aria-hidden="true"
>
</li>

<style>
  .proceso-vertice {
    position: relative;
    min-height: 2rem;
    list-style: none;

    /* Color del nodo del que sale, apagandose a tinta con la estela. Lo
       comparten la linea y la flecha. */
    --trazo: color-mix(
      in srgb,
      var(--tono),
      var(--color-ink-strong) calc(var(--estela, 0) * 100%)
    );
  }

  /* --- La linea --- */
  /* Base = movil: en una sola columna TODOS los tramos son verticales,
     incluidos los que en desktop van de costado. */
  .proceso-vertice::before {
    content: "";
    position: absolute;
    background: var(--trazo);
    top: 0;
    bottom: 0;
    left: calc(50% - 0.5px);
    width: 1px;
    scale: 1 var(--local, 0);
    transform-origin: center top;
  }

  /* --- La punta de flecha --- */
  /* Un cuadrado con dos bordes, girado: el vertice donde se cruzan apunta.
     Aparece en el ultimo cuarto del trazo (de ahi el *4 - 3): antes de eso
     flotaria adelante de la linea, separada, como si no fueran la misma cosa. */
  .proceso-vertice::after {
    content: "";
    position: absolute;
    width: 5px;
    height: 5px;
    border-top: 1px solid var(--trazo);
    border-right: 1px solid var(--trazo);
    opacity: clamp(0, calc(var(--local, 0) * 4 - 3), 1);

    /* Base = movil: apunta hacia abajo. */
    bottom: 1px;
    left: 50%;
    translate: -50% 0;
    rotate: 135deg;
  }

  @media (min-width: 768px) {
    .proceso-vertice[data-direccion="derecha"]::before,
    .proceso-vertice[data-direccion="izquierda"]::before {
      top: calc(50% - 0.5px);
      bottom: auto;
      left: 0;
      right: 0;
      width: auto;
      height: 1px;
      scale: var(--local, 0) 1;
    }

    .proceso-vertice[data-direccion="derecha"]::before {
      transform-origin: left center;
    }

    .proceso-vertice[data-direccion="izquierda"]::before {
      transform-origin: right center;
    }

    /* La flecha va SIEMPRE en el extremo de llegada, que es el opuesto al
       transform-origin de la linea. */
    .proceso-vertice[data-direccion="derecha"]::after,
    .proceso-vertice[data-direccion="izquierda"]::after {
      bottom: auto;
      top: 50%;
      translate: 0 -50%;
    }

    .proceso-vertice[data-direccion="derecha"]::after {
      left: auto;
      right: 1px;
      rotate: 45deg;
    }

    .proceso-vertice[data-direccion="izquierda"]::after {
      left: 1px;
      right: auto;
      rotate: -135deg;
    }
  }
</style>
