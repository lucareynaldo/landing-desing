---
// CTA final + footer en un solo bloque negro.
// Composicion tomada de sethlukin.com (display gigante, dos botones outline,
// metadata en las cuatro esquinas), pero renderizada con NUESTRO sistema
// tipografico para que no se lea como un injerto.
//
// El fondo es negro plano por decision del cliente. El espacio esta preparado
// para meter algo detras mas adelante (ver capa .footer-bg mas abajo).

// El mail salio a src/data porque tambien lo usa el bloque de contacto de
// "Como trabajamos". Las tres constantes de abajo se quedan aca: solo las usa
// el footer, y moverlas seria mover por mover.
import { EMAIL } from "../data/estudio";

// TODO placeholder: reemplazar por los datos reales del estudio
const SOCIAL = "instagram.com/estudio";
const CITY = "Buenos Aires, AR";
const UPDATED = "Agosto 2026";
---

<footer
  class="fixed inset-x-0 bottom-0 top-0 z-0 flex h-[100svh] flex-col justify-between overflow-hidden bg-void px-6 py-6 text-surface md:px-10 md:py-8"
  aria-labelledby="cta-title"
>
  {/* Grilla de fondo. Ver el bloque de estilos al final del archivo. */}
  <div class="footer-bg pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="grilla grilla-tenue"></div>
    <div class="grilla-foco"><div class="grilla"></div></div>
  </div>

  {/* --- Esquinas superiores --- */}
  <div class="relative flex items-start justify-between">
    <a
      href={`mailto:${EMAIL}`}
      class="type-meta transition-colors duration-(--duration-fast) ease-(--ease-inout) hover:text-ink-muted"
    >
      {EMAIL}
    </a>
    <a
      href={`https://${SOCIAL}`}
      target="_blank"
      rel="noopener noreferrer"
      class="type-meta transition-colors duration-(--duration-fast) ease-(--ease-inout) hover:text-ink-muted"
    >
      {SOCIAL}
    </a>
  </div>

  {/* --- Nucleo del CTA --- */}
  <div class="relative">
    {/*
      Switzer es mas ancha que la PP Neue Montreal de sethlukin, asi que el
      13.4vw medido en el original desborda. 9.6vw es el equivalente optico
      para que "CONSTRUYAMOS" (la linea larga) entre dentro del padding.
    */}
    <h2 id="cta-title" class="type-shout text-[11.5vw] md:text-[9.6vw]">
      <span class="block">Construyamos</span>
      <span class="block text-right">algo serio</span>
    </h2>

    <div class="mt-8 flex flex-wrap justify-end gap-3 md:mt-10 md:gap-4">
      <a
        href={`mailto:${EMAIL}`}
        class="group inline-flex items-center gap-3 rounded-full border border-surface/40 px-6 py-3 text-sm font-bold uppercase tracking-[-0.02em] transition-colors duration-(--duration-base) ease-(--ease-inout) hover:border-surface hover:bg-surface hover:text-void md:px-8 md:py-4 md:text-base"
      >
        Empezar un proyecto
        <span
          class="transition-transform duration-(--duration-base) ease-(--ease-out) group-hover:translate-x-1"
          aria-hidden="true">→</span
        >
      </a>
      <a
        href={`mailto:${EMAIL}`}
        class="inline-flex items-center gap-3 rounded-full border border-surface/40 px-6 py-3 text-sm font-bold uppercase tracking-[-0.02em] transition-colors duration-(--duration-base) ease-(--ease-inout) hover:border-surface hover:bg-surface hover:text-void md:px-8 md:py-4 md:text-base"
      >
        Hablemos
      </a>
    </div>
  </div>

  {/* --- Esquinas inferiores --- */}
  <div class="relative flex items-end justify-between">
    <p class="type-meta">
      {CITY}<br />
      <span data-clock aria-live="off">--:--</span>
    </p>
    <p class="type-meta text-right">
      Última actualización<br />
      {UPDATED}
    </p>
  </div>
</footer>

<script>
  // Reloj en vivo. sethlukin tiene un componente Framer dedicado a esto;
  // en plano son seis lineas.
  const el = document.querySelector<HTMLElement>("[data-clock]");
  if (el) {
    const tick = () => {
      el.textContent = new Date().toLocaleTimeString("es-AR", {
        hour: "2-digit",
        minute: "2-digit",
        hour12: false,
      });
    };
    tick();
    setInterval(tick, 1000 * 15);
  }
</script>

<style>
  /* Grilla del fondo del footer.
     
     Del mecanismo de teamworkgraph se midieron dos cosas: las lineas son un
     hairline de 1px, y la grilla nunca toca los bordes, se disuelve antes.

     La tercera se deduce de que la grilla de ellos es de UN SOLO color, un
     gris azulado: el multicolor no sale de pintar las lineas, sale de una capa
     de color abajo que se ve a traves de ellas. Aca se hace igual, porque
     pintar linea por linea daria el mismo resultado con diez veces mas
     trabajo y sin poder mover el color despues. */
  .footer-bg {
    --celda: 58px;
    --mx: 50%;
    --my: 50%;

    /* Disuelve el patron antes de los bordes. Sin esto la grilla termina en un
       corte recto contra el borde de la pantalla, que se lee como un error de
       recorte y no como una textura. */
    -webkit-mask-image: radial-gradient(ellipse 85% 70% at 50% 45%, #000 25%, transparent 100%);
    mask-image: radial-gradient(ellipse 85% 70% at 50% 45%, #000 25%, transparent 100%);
  }

  .grilla {
    position: absolute;
    inset: 0;

    /* Base neutra, y NO es decorativa: es lo que garantiza que la grilla
       exista en todos lados.

       Como la tinta de las lineas es la capa de color, donde el color no
       llega la grilla directamente no esta -no queda tenue, desaparece-. Con
       las manchas solas quedaba una franja muerta en el medio, entre donde
       dejaban de alcanzar las de arriba y donde empezaban las de abajo. El
       gris llena el hueco y las manchas lo tiñen encima. */
    background-color: hsla(222, 6%, 55%, 0.5);

    /* Las manchas de color, en los acentos de la marca. Los radios son
       generosos a proposito: con 40% de alto las de arriba y las de abajo no
       se tocaban. */
    background-image:
      radial-gradient(55% 50% at 15% 20%, var(--color-accent) 0%, transparent 70%),
      radial-gradient(55% 50% at 85% 25%, #0055ff 0%, transparent 70%),
      radial-gradient(55% 50% at 25% 85%, #12b76a 0%, transparent 70%),
      radial-gradient(55% 50% at 80% 80%, var(--color-accent-warm) 0%, transparent 70%);

    /* Las dos capas de mascara se componen con `add`, que es la union: una
       aporta las verticales y la otra las horizontales. */
    -webkit-mask-image:
      repeating-linear-gradient(90deg, #000 0 1px, transparent 1px var(--celda)),
      repeating-linear-gradient(180deg, #000 0 1px, transparent 1px var(--celda));
    mask-image:
      repeating-linear-gradient(90deg, #000 0 1px, transparent 1px var(--celda)),
      repeating-linear-gradient(180deg, #000 0 1px, transparent 1px var(--celda));
  }

  /* La base, siempre presente: le da textura al footer aunque nadie pase el
     mouse, que es lo que sostiene el efecto en tactil y en teclado. */
  .grilla-tenue {
    opacity: 0.22;
  }

  /* La misma grilla a full, recortada a un circulo pegado al cursor. */
  .grilla-foco {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--duration-slow) var(--ease-out);
    -webkit-mask-image: radial-gradient(circle 240px at var(--mx) var(--my), #000 0%, transparent 100%);
    mask-image: radial-gradient(circle 240px at var(--mx) var(--my), #000 0%, transparent 100%);
  }

  /* La clase la pone el script recien con el primer movimiento del puntero.
     Sin eso el circulo arrancaria encendido y clavado en el centro, que es una
     mancha que nadie pidio. */
  .footer-bg.con-foco .grilla-foco {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .grilla-foco {
      display: none;
    }
  }
</style>

<script>
  // La grilla se enciende cerca del cursor, y solo mientras el footer se ve.
  //
  // La señal de visibilidad es [data-fin-lamina], no el footer: el footer es
  // fixed y ocupa la pantalla entera, asi que observarlo daria siempre
  // intersectando. No esta fuera de vista cuando no se ve, esta tapado por la
  // lamina de contenido.
  const capa = document.querySelector<HTMLElement>(".footer-bg");
  const finLamina = document.querySelector("[data-fin-lamina]");

  const fino = matchMedia("(pointer: fine)").matches;
  const quieto = matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (capa && finLamina && fino && !quieto) {
    let pendiente = false;
    let x = 0;
    let y = 0;

    const pintar = () => {
      pendiente = false;
      const r = capa.getBoundingClientRect();
      capa.style.setProperty("--mx", `${x - r.left}px`);
      capa.style.setProperty("--my", `${y - r.top}px`);
      capa.classList.add("con-foco");
    };

    const mover = (e: PointerEvent) => {
      x = e.clientX;
      y = e.clientY;
      if (!pendiente) {
        pendiente = true;
        requestAnimationFrame(pintar);
      }
    };

    // "Destapado" NO es lo mismo que "intersectando".
    //
    // El centinela entra en pantalla mientras la lamina se esta yendo, pero si
    // se sigue scrolleando termina de salir por arriba, y ahi isIntersecting
    // vuelve a false. Mirando solo eso, el efecto se apagaba justo cuando el
    // footer quedaba del todo a la vista y solo andaba durante el pasaje.
    //
    // Tambien esta destapado cuando el centinela ya paso de largo hacia
    // arriba, o sea con su borde superior en negativo.
    const destapado = (e: IntersectionObserverEntry) =>
      e.isIntersecting || e.boundingClientRect.top < 0;

    // Mover la mascara repinta la capa entera, asi que es la parte cara de
    // esto y no tiene sentido pagarla mientras el footer esta tapado. El
    // listener se da de alta y de baja con esa señal, en vez de quedar
    // siempre puesto preguntando si corresponde.
    new IntersectionObserver((entradas) => {
      if (destapado(entradas[0])) {
        window.addEventListener("pointermove", mover, { passive: true });
      } else {
        window.removeEventListener("pointermove", mover);
        capa.classList.remove("con-foco");
      }
    }).observe(finLamina);
  }
</script>
