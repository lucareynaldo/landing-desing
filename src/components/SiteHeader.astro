---
// Header propio, en el idioma de readymag: pastillas flotantes,
// redondeado total, fondo translucido. No copia ninguno en particular.
// "Trabajos" va a la pagina de portfolio, no al ancla del hero: el hero ya
// esta arriba de todo, asi que el ancla no llevaba a ningun lado, y desde
// /trabajos directamente no existia.
const NAV = [
  { label: "Trabajos", href: "/trabajos" },
  { label: "Qué hacemos", href: "/#que-hacemos" },
  { label: "Clientes", href: "/#clientes" },
];
---

{/*
  Sticky, no fixed: al estar dentro de la lamina de contenido, el header se
  va con ella cuando el footer se revela. Si fuera fixed quedaria flotando
  encima del bloque negro. Cero JS.
*/}
<header
  class="site-header pointer-events-none sticky top-0 z-50 px-4 py-4 transition-[background-color,backdrop-filter] duration-(--duration-base) ease-(--ease-inout) md:px-6 md:py-5"
  data-header
>
  <div class="pointer-events-auto mx-auto flex max-w-[1400px] items-center justify-between gap-4">
    <a
      href="/"
      class="grid size-11 place-items-center rounded-full bg-ink-strong text-surface transition-transform duration-(--duration-base) ease-(--ease-out) hover:scale-105"
      aria-label="Inicio"
    >
      <span class="type-meta text-[0.7rem] leading-none">E</span>
    </a>

    <nav class="hidden items-center gap-1 rounded-full bg-surface/80 p-1 backdrop-blur-md md:flex">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class="rounded-full px-4 py-2 text-sm font-medium tracking-[-0.011em] text-ink transition-colors duration-(--duration-base) ease-(--ease-inout) hover:bg-surface-3"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      {/*
        Se muestra el icono del modo al que se VA, no el actual: es lo que
        convierte al boton en una accion en vez de en un cartel de estado.
      */}
      <button
        type="button"
        data-tema-switch
        class="grid size-11 place-items-center rounded-full bg-surface/80 text-ink backdrop-blur-md transition-colors duration-(--duration-base) ease-(--ease-inout) hover:bg-surface-3"
        aria-label="Cambiar entre modo claro y oscuro"
      >
        <svg
          class="tema-luna"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.6 6.6 0 0 0 10.5 10.5z"></path>
        </svg>
        <svg
          class="tema-sol"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
          ></path>
        </svg>
      </button>

      <a
        href="#contacto"
        class="rounded-full bg-accent-warm px-5 py-2.5 text-sm font-bold tracking-[-0.011em] text-surface transition-transform duration-(--duration-base) ease-(--ease-out) hover:scale-105"
      >
        Hablemos
      </a>
    </div>
  </div>
</header>

<style>
  /* Transparente arriba de todo; con fondo apenas empieza a pasar contenido
     por detras, si no el logo se superpone al texto de las secciones. */
  .site-header.pegado {
    background-color: color-mix(in srgb, var(--color-surface) 82%, transparent);
    backdrop-filter: blur(12px);
  }

  /* En claro se ve la luna y en oscuro el sol: el icono anuncia a donde va el
     click. Se conmuta por CSS y no por JS para que ya salga bien del script
     del head, sin esperar a que hidrate nada. */
  .tema-sol {
    display: none;
  }
  :global([data-tema="oscuro"]) .tema-sol {
    display: block;
  }
  :global([data-tema="oscuro"]) .tema-luna {
    display: none;
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  if (header) {
    let pendiente = false;
    const evaluar = () => {
      pendiente = false;
      header.classList.toggle("pegado", window.scrollY > 24);
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!pendiente) {
          pendiente = true;
          requestAnimationFrame(evaluar);
        }
      },
      { passive: true },
    );
    evaluar();
  }

  // --- Switch de tema ---
  // El estado inicial ya lo dejo puesto el script del head; aca solo se
  // alterna y se guarda.
  const boton = document.querySelector<HTMLButtonElement>("[data-tema-switch]");

  if (boton) {
    const raiz = document.documentElement;

    const guardado = () => {
      try {
        return localStorage.getItem("tema");
      } catch {
        return null;
      }
    };

    boton.addEventListener("click", () => {
      const nuevo = raiz.dataset.tema === "oscuro" ? "claro" : "oscuro";
      raiz.dataset.tema = nuevo;
      try {
        localStorage.setItem("tema", nuevo);
      } catch {
        /* el tema igual cambia, solo que no sobrevive a la recarga */
      }
    });

    // Mientras nadie haya elegido a mano, el sitio sigue al sistema en vivo:
    // si el SO cambia de tema con la pestaña abierta, la web acompaña.
    matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
      if (guardado()) return;
      raiz.dataset.tema = e.matches ? "oscuro" : "claro";
    });
  }
</script>
