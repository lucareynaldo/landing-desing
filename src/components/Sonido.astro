---
// Sonido de interfaz. Todo el audio del sitio vive aca y en ningun otro lado.
//
// Dos decisiones que explican la forma del archivo:
//
// 1. Se sintetiza, no se cargan archivos. Son ~20 lineas de Web Audio contra
//    un fetch que puede llegar tarde justo en el primer click, que es cuando
//    mas se nota. Cero bytes de red, cero latencia, y los sonidos quedan
//    editables como numeros en vez de como assets.
//
// 2. Los disparadores son delegados en document, no cableados instancia por
//    instancia. En el sitio no hay un componente Boton reutilizable: hay
//    botones sueltos en cinco archivos, y ademas varios "botones" son <a>.
//    Cablear cada uno significaria tocar cinco archivos hoy y olvidarse del
//    sexto manana. Con delegacion, un boton nuevo suena sin hacer nada.
//
// La gramatica de la familia, para que lo que agreguemos despues pertenezca:
//   - siempre onda sine y envolvente percusiva (ataque de 1-2ms)
//   - glide de frecuencia = navegacion (algo se abre, algo se cierra)
//     frecuencia fija    = accion puntual (algo se apreto)
//   - cuanto mas seguido se puede disparar un sonido, mas bajo su pico
---

<script is:inline>
  (() => {
    // --- Presets -------------------------------------------------------
    // desde/hasta: barrido de frecuencia en Hz (iguales = tono fijo)
    // ataque: rampa lineal hasta el pico | caida: constante de tiempo
    // cola: silencio de gracia antes de cortar la fuente
    // pico: amplitud maxima, de 0 a 1
    // onda: sine (por defecto), triangle o ruido
    // filtro: pasabanda {frecuencia, q}, sobre todo para domar el ruido
    // capas: apila varias fuentes en un solo sonido
    // corta: al redisparar, silencia la copia anterior en vez de sumarla
    const SONIDOS = {
      // El par de la vista detalle. Suben y bajan porque acompañan un morph
      // que tambien va y vuelve: son el mismo gesto traducido a audio.
      abrir: { desde: 420, hasta: 760, ataque: 0.002, caida: 0.09, cola: 0.03, pico: 0.392 },
      cerrar: { desde: 720, hasta: 360, ataque: 0.002, caida: 0.08, cola: 0.025, pico: 0.408 },

      // Boton: tono FIJO. Un boton no tiene direccion, no abre ni cierra
      // nada, y el contraste contra el barrido del par de arriba es lo que
      // hace que el oido los separe sin pensarlo. 550Hz cae una quinta arriba
      // de los 360 en los que aterriza `cerrar`, asi que sigue sonando de la
      // misma familia. Mas corto y mas bajo que el par: se aprieta seguido y
      // a igual volumen cansaria.
      boton: { desde: 550, hasta: 550, ataque: 0.001, caida: 0.045, cola: 0.015, pico: 0.3 },

      // Agarrar un icono flotante: registro grave y una caida chiquita, que
      // es como suena el contacto con algo que tiene peso. El pico es el mas
      // bajo de todos a proposito: se pueden agarrar diez iconos en cinco
      // segundos y tiene que seguir siendo agradable.
      agarrar: { desde: 320, hasta: 240, ataque: 0.001, caida: 0.05, cola: 0.02, pico: 0.2 },

      // Pasar de proyecto: un click, no un tono. Es el unico apilado en capas
      // porque es el unico que se puede disparar en rafaga, y para eso tiene
      // que ser MUY corto (~30ms contra los 120 de abrir). A esa duracion un
      // oscilador solo suena a nada; el caracter sale del apilado:
      //   - el ruido filtrado da el transitorio, la sensacion de golpe seco
      //   - el agudo da la altura, y baja apenas para no quedar plano
      //   - el grave da el cuerpo, para que no sea un chasquido de insecto
      // `corta` cancela lo que este sonando antes de disparar: manteniendo la
      // flecha apretada el navegador repite ~30 veces por segundo y sin esto
      // se apilan treinta copias en un pure.
      pasar: {
        corta: true,
        capas: [
          { onda: "ruido", filtro: { frecuencia: 7200, q: 1.1 }, ataque: 0, caida: 0.004, cola: 0.002, pico: 0.25 },
          { onda: "sine", desde: 2200, hasta: 1800, ataque: 0, caida: 0.014, cola: 0.005, pico: 0.38 },
          { onda: "triangle", desde: 320, hasta: 240, ataque: 0, caida: 0.021, cola: 0.008, pico: 0.25 },
        ],
      },
    };

    const VOLUMEN = 1; // perilla unica para subir o bajar todo a la vez
    const PISO = 0.0001; // una rampa exponencial no puede tocar el cero

    const quieto = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let ctx = null;
    let ruido = null; // buffer de ruido blanco, se genera una sola vez
    const vivos = new Map(); // preset -> capas sonando, para poder cortarlas

    /** Un segundo de ruido blanco. Alcanza y sobra: las capas duran ~4ms. */
    const bufferRuido = () => {
      if (ruido) return ruido;
      ruido = ctx.createBuffer(1, ctx.sampleRate, ctx.sampleRate);
      const datos = ruido.getChannelData(0);
      for (let i = 0; i < datos.length; i++) datos[i] = Math.random() * 2 - 1;
      return ruido;
    };

    /** Silencia lo que este sonando de ese preset, sin dejar un corte seco. */
    const cortar = (nombre, t) => {
      const previas = vivos.get(nombre);
      if (!previas) return;
      for (const { vol, fuente } of previas) {
        vol.gain.cancelScheduledValues(t);
        vol.gain.setValueAtTime(vol.gain.value, t);
        vol.gain.setTargetAtTime(PISO, t, 0.003);
        try {
          fuente.stop(t + 0.02);
        } catch {
          /* ya estaba parada */
        }
      }
      vivos.delete(nombre);
    };

    /** Toca uno de los presets. Nunca tira: si no hay audio, no pasa nada. */
    const sonar = (nombre) => {
      if (quieto) return;
      const s = SONIDOS[nombre];
      if (!s) return;

      // Sin un gesto previo del usuario el navegador no deja sonar nada y el
      // AudioContext queda suspendido para siempre. Pasa en la entrada directa
      // por URL, que abre el detalle sin que nadie haya clickeado.
      if (navigator.userActivation && !navigator.userActivation.hasBeenActive) return;

      try {
        if (!ctx) ctx = new AudioContext();
        if (ctx.state === "suspended") ctx.resume().catch(() => {});
      } catch {
        return; // sin Web Audio el sitio funciona igual, solo que mudo
      }

      const t = ctx.currentTime;
      if (s.corta) cortar(nombre, t);

      // Un preset sin capas es un preset de una sola capa. Asi los cuatro
      // sonidos simples siguen escribiendose en una linea.
      const capas = s.capas ?? [s];
      const nodos = [];
      let largo = 0;

      for (const c of capas) {
        const dur = c.ataque + c.caida + c.cola;
        largo = Math.max(largo, dur);

        let fuente;
        if (c.onda === "ruido") {
          fuente = ctx.createBufferSource();
          fuente.buffer = bufferRuido();
        } else {
          fuente = ctx.createOscillator();
          fuente.type = c.onda ?? "sine";
          fuente.frequency.setValueAtTime(c.desde, t);
          // El barrido corre a lo largo de TODA la envolvente. Con tono fijo
          // el sonido es un pip; el barrido es lo que le da direccion.
          if (c.hasta !== c.desde) {
            fuente.frequency.exponentialRampToValueAtTime(Math.max(c.hasta, 1), t + dur);
          }
        }

        // Envolvente percusiva: rampa lineal al pico y caida exponencial hacia
        // el piso con constante de tiempo caida/3 (a las tres constantes ya
        // bajo ~95%, asi que la cola se apaga sola dentro de la duracion).
        const vol = ctx.createGain();
        vol.gain.setValueAtTime(PISO, t);
        if (c.ataque > 0) {
          vol.gain.linearRampToValueAtTime(c.pico * VOLUMEN, t + c.ataque);
        } else {
          // Ataque cero es literal: el golpe seco es justamente el caracter.
          vol.gain.setValueAtTime(c.pico * VOLUMEN, t);
        }
        vol.gain.setTargetAtTime(PISO, t + c.ataque, c.caida / 3);

        // El pasabanda es lo que convierte al ruido blanco en un tick con
        // altura en vez de un shhh de radio mal sintonizada.
        if (c.filtro) {
          const bp = ctx.createBiquadFilter();
          bp.type = "bandpass";
          bp.frequency.value = c.filtro.frecuencia;
          bp.Q.value = c.filtro.q;
          fuente.connect(bp);
          bp.connect(vol);
        } else {
          fuente.connect(vol);
        }

        vol.connect(ctx.destination);
        fuente.start(t);
        // Margen sobre la duracion nominal: cortar la fuente antes de que la
        // ganancia llegue al piso mete un click audible.
        fuente.stop(t + dur + 0.1);
        nodos.push({ vol, fuente });
      }

      if (s.corta) {
        vivos.set(nombre, nodos);
        setTimeout(
          () => {
            if (vivos.get(nombre) === nodos) vivos.delete(nombre);
          },
          (largo + 0.15) * 1000,
        );
      }
    };

    // TrabajoDetalle dispara `abrir` y `cerrar` a mano, porque el momento
    // exacto depende de su maquina de estados (el click en un tile no siempre
    // abre, el cierre puede venir del boton atras del navegador o de Escape).
    window.sonar = sonar;

    // --- Disparadores delegados ----------------------------------------

    // Todo lo clickeable suena, salvo lo que YA tiene su propio sonido: los
    // tiles abren el detalle (`abrir`) y el boton de cerrar lo cierra
    // (`cerrar`). Sin estas exclusiones se escucharian dos sonidos pisados.
    document.addEventListener("click", (e) => {
      const el = e.target.closest?.("button, a[href]");
      if (!el || el.closest("[data-trabajo], [data-cerrar]")) return;
      sonar("boton");
    });

    // Agarre de un icono flotante de "Que hacemos".
    //
    // Se exige `.fisica-activa`, que la seccion se pone sola cuando el drag
    // queda habilitado. Los iconos existen en el DOM desde el principio, pero
    // no se pueden agarrar durante el primer segundo y medio, ni nunca en
    // tactil (el arrastre robaria el scroll). Sonar ahi seria prometer una
    // interaccion que no existe.
    document.addEventListener(
      "pointerdown",
      (e) => {
        if (e.button !== 0) return; // el boton derecho abre el menu, no agarra
        if (e.target.closest?.(".fisica-activa .icon-node")) sonar("agarrar");
      },
      { passive: true },
    );
  })();
</script>
