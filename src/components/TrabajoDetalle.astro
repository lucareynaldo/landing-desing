---
import { TRABAJOS } from "../data/trabajos";

// Vista detalle, calcada de la arquitectura medida en recent.design:
//
//  1. El carrusel NO se desmonta ni se le toca ningun estilo. Sigue vivo
//     debajo. Por eso no hay nada que restaurar al cerrar.
//  2. El detalle es una capa fixed montada encima.
//  3. El desenfoque lo hace un backdrop-filter DESDE ESTA CAPA, nunca un
//     filter aplicado al carrusel.
//  4. El morph anima geometria real (left/top/width/height), NO transform.
//     Un scale() estiraria el contenido: pasar un tile de 276px a 900px de
//     ancho chupa la imagen. Animando la caja, el object-cover se recalcula
//     en cada frame y el media se ve correcto todo el tiempo. Se paga layout
//     por frame en un solo elemento a cambio de cero distorsion.
//
// Duraciones tomadas de sus tokens: 180ms para el contenido, 280ms el morph,
// con cubic-bezier(.16, 1, .3, 1).

const DATOS = TRABAJOS.map((t) => ({
  slug: t.slug,
  cliente: t.cliente,
  titulo: t.titulo,
  categoria: t.categoria,
  descripcion: t.descripcion,
  anio: t.anio,
  servicios: t.servicios,
  tono: t.tono,
  media: t.media ?? null,
}));
---

<div
  data-detalle
  class="fixed inset-0 z-[100] hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="detalle-titulo"
>
  {/* Desenfoque del fondo. La capa de abajo no se entera. */}
  <div
    data-fondo
    class="absolute inset-0 bg-surface/70 backdrop-blur-[8px]"
    aria-hidden="true"
  >
  </div>

  <div class="relative flex h-full w-full">
    {/* --- Panel lateral --- */}
    <aside
      data-panel
      class="flex h-full w-full shrink-0 flex-col overflow-y-auto bg-surface px-6 py-6 md:w-[26rem] md:px-8 md:py-8 lg:w-[30rem]"
    >
      <div class="flex items-center justify-between">
        <button
          type="button"
          data-cerrar
          class="grid size-9 place-items-center rounded-full bg-surface-2 text-ink transition-colors duration-(--duration-fast) ease-(--ease-inout) hover:bg-surface-3"
          aria-label="Cerrar"
        >
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
            <path
              d="M1 1l12 12M13 1L1 13"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
            ></path>
          </svg>
        </button>

        <div class="flex gap-1.5">
          <button
            type="button"
            data-anterior
            class="grid size-9 place-items-center rounded-full bg-surface-2 text-ink transition-colors duration-(--duration-fast) ease-(--ease-inout) hover:bg-surface-3 disabled:opacity-30"
            aria-label="Trabajo anterior"
          >
            <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
              <path
                d="M8.5 2L3.5 7l5 5"
                stroke="currentColor"
                stroke-width="1.6"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
          <button
            type="button"
            data-siguiente
            class="grid size-9 place-items-center rounded-full bg-surface-2 text-ink transition-colors duration-(--duration-fast) ease-(--ease-inout) hover:bg-surface-3 disabled:opacity-30"
            aria-label="Trabajo siguiente"
          >
            <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
              <path
                d="M5.5 2l5 5-5 5"
                stroke="currentColor"
                stroke-width="1.6"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>
      </div>

      <div data-contenido class="mt-10 flex flex-col gap-6">
        <div>
          <p class="type-meta text-ink-muted" data-campo="categoria"></p>
          <h2
            id="detalle-titulo"
            class="type-display mt-3 text-[clamp(1.5rem,2.4vw,2.1rem)] text-ink-strong"
            data-campo="titulo"
          >
          </h2>
          <p class="type-meta mt-3 text-ink-soft" data-campo="cliente"></p>
        </div>

        <p class="type-body max-w-[42ch] text-ink-soft" data-campo="descripcion"></p>

        <dl class="mt-2 flex flex-col gap-0 border-t border-ink/10">
          <div class="flex justify-between gap-6 border-b border-ink/10 py-3">
            <dt class="type-meta text-ink-muted">Año</dt>
            <dd class="type-meta text-ink" data-campo="anio"></dd>
          </div>
          <div class="flex justify-between gap-6 border-b border-ink/10 py-3">
            <dt class="type-meta shrink-0 text-ink-muted">Servicios</dt>
            <dd class="type-meta text-right text-ink" data-campo="servicios"></dd>
          </div>
        </dl>
      </div>

      <p class="type-meta mt-auto pt-8 text-ink-muted">
        Mockup — el asset final lo provee el diseñador
      </p>
    </aside>

    {/*
      Area del media. El destino es un elemento invisible: lo posiciona el
      CSS y el JS solo lee su caja. Asi el layout responsive se define aca y
      no queda hardcodeado en el script.
    */}
    <div data-area class="relative hidden flex-1 p-8 md:block lg:p-12">
      <div data-destino class="size-full"></div>
    </div>
  </div>

  {/* El elemento que morphea. Vive fuera del flujo, en coordenadas de viewport. */}
  <div
    data-media
    class="pointer-events-none fixed overflow-hidden rounded-2xl"
    aria-hidden="true"
  >
  </div>
</div>

<script is:inline define:vars={{ DATOS }}>
  (() => {
    const raiz = document.querySelector("[data-detalle]");
    if (!raiz) return;

    const fondo = raiz.querySelector("[data-fondo]");
    const panel = raiz.querySelector("[data-panel]");
    const destino = raiz.querySelector("[data-destino]");
    const area = raiz.querySelector("[data-area]");
    const media = raiz.querySelector("[data-media]");
    const contenido = raiz.querySelector("[data-contenido]");

    const EASE = "cubic-bezier(.16, 1, .3, 1)";
    const D_MORPH = 280;
    const D_CONTENIDO = 180;
    const PROPORCION = 16 / 10;

    const quieto = matchMedia("(prefers-reduced-motion: reduce)").matches;

    let abierto = false;
    let indice = -1;
    let tileOrigen = null;
    let focoPrevio = null;

    // Cada apertura y cada cierre incrementa la generacion. Todo callback
    // asincrono (animation.finished, setTimeout) verifica que su generacion
    // siga siendo la vigente antes de tocar nada. Sin esto, un cierre lento
    // puede terminar encima de una apertura nueva y dejar el estado partido:
    // el media visible con el panel y el fondo ya desvanecidos.
    let generacion = 0;

    /** Corre una animacion cancelando cualquier otra previa del mismo elemento. */
    const animar = (el, keyframes, opciones) => {
      el.getAnimations().forEach((a) => a.cancel());
      return el.animate(keyframes, opciones);
    };

    /**
     * Congela o reanuda las filas del carrusel.
     * El grid de recent.design es estatico, asi que su morph de cierre siempre
     * aterriza donde empezo. El nuestro se mueve: si siguiera corriendo, al
     * cerrar el tile ya no estaria en su lugar y el morph de vuelta apuntaria
     * al vacio. Detras del blur nadie nota que esta pausado.
     */
    const congelarCarrusel = (si) => {
      document.querySelectorAll(".marquee-track").forEach((t) => {
        t.style.animationPlayState = si ? "paused" : "";
      });
    };

    const porSlug = (s) => DATOS.findIndex((d) => d.slug === s);

    /**
     * Tile de ese slug que MAS se ve en pantalla.
     *
     * El marquee duplica la pista para cerrar el bucle, asi que de cada
     * trabajo hay dos tiles en el DOM. La segunda copia lleva aria-hidden
     * para que un lector de pantalla no anuncie todo dos veces, pero
     * visualmente es un tile igual de real: durante media vuelta es la unica
     * que se ve. Elegir por aria-hidden en vez de por visibilidad hacia que
     * el morph arrancara desde un tile fuera de pantalla.
     */
    const buscarTile = (slug) => {
      const todos = Array.from(document.querySelectorAll(`[data-trabajo="${slug}"]`));
      if (!todos.length) return null;
      let mejor = todos[0];
      let mejorVisible = -1;
      for (const el of todos) {
        const r = el.getBoundingClientRect();
        const visible = Math.max(0, Math.min(r.right, innerWidth) - Math.max(r.left, 0));
        if (visible > mejorVisible) {
          mejorVisible = visible;
          mejor = el;
        }
      }
      return mejor;
    };

    /** Caja destino: se encaja una proporcion 16/10 dentro del area disponible. */
    const cajaDestino = () => {
      const r = destino.getBoundingClientRect();
      let w = r.width;
      let h = w / PROPORCION;
      if (h > r.height) {
        h = r.height;
        w = h * PROPORCION;
      }
      return { left: r.left + (r.width - w) / 2, top: r.top + (r.height - h) / 2, width: w, height: h };
    };

    const ponerCaja = (c) => {
      media.style.left = `${c.left}px`;
      media.style.top = `${c.top}px`;
      media.style.width = `${c.width}px`;
      media.style.height = `${c.height}px`;
    };

    const pintar = (d) => {
      contenido.querySelector('[data-campo="categoria"]').textContent = d.categoria;
      contenido.querySelector('[data-campo="titulo"]').textContent = d.titulo;
      contenido.querySelector('[data-campo="cliente"]').textContent = d.cliente;
      contenido.querySelector('[data-campo="descripcion"]').textContent = d.descripcion;
      contenido.querySelector('[data-campo="anio"]').textContent = d.anio;
      contenido.querySelector('[data-campo="servicios"]').textContent = d.servicios.join(", ");

      media.style.backgroundColor = d.tono;
      media.innerHTML = d.media
        ? `<img src="${d.media}" alt="" class="size-full object-cover">`
        : "";
    };

    const marcarOrigen = (tile) => {
      if (tileOrigen) tileOrigen.removeAttribute("data-origen");
      tileOrigen = tile || null;
      if (tileOrigen) tileOrigen.setAttribute("data-origen", "");
    };

    function abrir(i, tile, conHistoria = true) {
      if (abierto) return;
      const d = DATOS[i];
      if (!d) return;

      abierto = true;
      indice = i;
      generacion++;
      focoPrevio = document.activeElement;

      congelarCarrusel(true);
      // Bloquea el scroll de la pagina: Lenis sigue vivo debajo y si no,
      // la rueda del mouse sobre el detalle mueve el carrusel de atras.
      document.documentElement.style.overflow = "hidden";
      document.body.setAttribute("data-detalle-abierto", "");
      pintar(d);
      marcarOrigen(tile);

      raiz.classList.remove("hidden");

      const r0 = tile
        ? tile.getBoundingClientRect()
        : (() => { const c = cajaDestino(); return { left: c.left, top: c.top + 24, width: c.width, height: c.height }; })();
      ponerCaja({ left: r0.left, top: r0.top, width: r0.width, height: r0.height });

      // Lectura forzada para que el navegador tome la caja inicial antes de animar
      void media.offsetWidth;
      const r1 = cajaDestino();

      if (quieto) {
        ponerCaja(r1);
      } else {
        animar(
          media,
          [
            { left: `${r0.left}px`, top: `${r0.top}px`, width: `${r0.width}px`, height: `${r0.height}px` },
            { left: `${r1.left}px`, top: `${r1.top}px`, width: `${r1.width}px`, height: `${r1.height}px` },
          ],
          { duration: D_MORPH, easing: EASE },
        );
        ponerCaja(r1);

        animar(fondo, [{ opacity: 0 }, { opacity: 1 }], { duration: D_CONTENIDO, easing: EASE });
        animar(
          panel,
          [
            { opacity: 0, transform: "translateX(-12px)" },
            { opacity: 1, transform: "translateX(0)" },
          ],
          { duration: D_CONTENIDO, easing: EASE, delay: 40, fill: "backwards" },
        );
      }

      if (conHistoria) {
        history.pushState({ trabajo: d.slug }, "", `?trabajo=${d.slug}`);
      }
      raiz.querySelector("[data-cerrar]").focus({ preventScroll: true });
    }

    function cerrar(conHistoria = true) {
      if (!abierto) return;
      abierto = false;
      generacion++;
      const mia = generacion;

      // Caja REAL en este instante, no la del estilo inline. Si el cierre
      // llega en pleno morph de apertura, el estilo inline ya dice el destino
      // final mientras el elemento todavia esta a mitad de camino: arrancar
      // de ahi produciria un salto visible.
      const vr = media.getBoundingClientRect();
      const r1 = { left: vr.left, top: vr.top, width: vr.width, height: vr.height };
      const r0 = tileOrigen ? tileOrigen.getBoundingClientRect() : null;

      let listo = false;
      const terminar = () => {
        // Un cierre viejo no puede pisar una apertura nueva.
        if (listo || generacion !== mia) return;
        listo = true;
        raiz.classList.add("hidden");
        marcarOrigen(null);
        congelarCarrusel(false);
        document.documentElement.style.overflow = "";
        document.body.removeAttribute("data-detalle-abierto");
        // Se limpia el estado del media: nada sobrevive al proximo ciclo.
        media.getAnimations().forEach((a) => a.cancel());
        media.removeAttribute("style");
        media.innerHTML = "";
        if (focoPrevio && document.contains(focoPrevio)) focoPrevio.focus({ preventScroll: true });
      };

      if (quieto || !r0) {
        terminar();
      } else {
        animar(fondo, [{ opacity: 1 }, { opacity: 0 }], { duration: D_CONTENIDO, easing: EASE, fill: "forwards" });
        animar(
          panel,
          [
            { opacity: 1, transform: "translateX(0)" },
            { opacity: 0, transform: "translateX(-12px)" },
          ],
          { duration: D_CONTENIDO, easing: EASE, fill: "forwards" },
        );
        const a = animar(
          media,
          [
            { left: `${r1.left}px`, top: `${r1.top}px`, width: `${r1.width}px`, height: `${r1.height}px` },
            { left: `${r0.left}px`, top: `${r0.top}px`, width: `${r0.width}px`, height: `${r0.height}px` },
          ],
          { duration: D_MORPH, easing: EASE, fill: "forwards" },
        );
        a.finished.then(terminar).catch(terminar);
        // Red de seguridad: si `finished` no llega (animacion descartada por
        // el navegador, pestaña en segundo plano, keyframe invalido), el
        // overlay quedaria colgado con el media a la vista. Esto lo cierra igual.
        setTimeout(terminar, D_MORPH + 200);
      }

      if (conHistoria && location.search.includes("trabajo=")) history.back();
    }

    /** Salta a otro trabajo sin cerrar: cambia contenido y reencaja el media. */
    function saltar(paso) {
      if (!abierto) return;
      const mia = generacion;
      const i = (indice + paso + DATOS.length) % DATOS.length;
      const d = DATOS[i];
      indice = i;

      const opciones = { duration: D_CONTENIDO, easing: EASE };
      if (!quieto) animar(contenido, [{ opacity: 1 }, { opacity: 0 }], opciones);

      setTimeout(
        () => {
          // Si cerraron mientras corria el crossfade, este timeout no debe
          // repintar ni volver a marcar un tile como origen: dejaria un tile
          // invisible para siempre.
          if (generacion !== mia || !abierto) return;
          pintar(d);
          marcarOrigen(buscarTile(d.slug));
          if (!quieto) animar(contenido, [{ opacity: 0 }, { opacity: 1 }], opciones);
        },
        quieto ? 0 : D_CONTENIDO,
      );

      history.replaceState({ trabajo: d.slug }, "", `?trabajo=${d.slug}`);
    }

    // --- disparadores ---
    // Cualquier elemento con data-trabajo abre el detalle: los tiles del
    // marquee del hero y las piezas de la grilla del portfolio.
    document.addEventListener("click", (e) => {
      const tile = e.target.closest?.("[data-trabajo]");
      if (!tile) return;
      // Se abre con CUALQUIER copia, incluida la duplicada del bucle: es la
      // que el usuario esta viendo. Y el morph arranca desde la que clickeo,
      // no desde su gemela, que puede estar fuera de pantalla.
      const i = porSlug(tile.dataset.trabajo);
      if (i >= 0) abrir(i, tile);
    });

    raiz.querySelector("[data-cerrar]").addEventListener("click", () => cerrar());
    raiz.querySelector("[data-anterior]").addEventListener("click", () => saltar(-1));
    raiz.querySelector("[data-siguiente]").addEventListener("click", () => saltar(1));
    fondo.addEventListener("click", () => cerrar());

    // Click en el vacio alrededor de la imagen -> cerrar.
    //
    // No alcanza con el listener del fondo: el flex de arriba lo tapa entero,
    // asi que a [data-fondo] no le llega un solo click. El area del media es
    // la que los recibe, y como el elemento que morphea es fixed y
    // pointer-events:none, los clicks SOBRE la imagen tambien caen aca. Por eso
    // no se puede distinguir por target y se compara contra su caja: adentro
    // de la imagen no pasa nada, afuera cierra.
    area?.addEventListener("click", (e) => {
      const r = media.getBoundingClientRect();
      const dentro =
        e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
      if (!dentro) cerrar();
    });

    document.addEventListener("keydown", (e) => {
      if (!abierto) return;
      if (e.key === "Escape") cerrar();
      else if (e.key === "ArrowLeft") saltar(-1);
      else if (e.key === "ArrowRight") saltar(1);
    });

    // El boton atras del navegador cierra, como en la referencia
    window.addEventListener("popstate", () => {
      if (abierto) cerrar(false);
    });

    // Si la ventana cambia de tamaño con el detalle abierto, hay que reencajar
    window.addEventListener("resize", () => {
      if (abierto) ponerCaja(cajaDestino());
    });

    // Entrada directa por URL: sin tile de origen, no hay morph, solo aparece
    const slugInicial = new URLSearchParams(location.search).get("trabajo");
    if (slugInicial) {
      const i = porSlug(slugInicial);
      if (i >= 0) requestAnimationFrame(() => abrir(i, buscarTile(slugInicial), false));
    }
  })();
</script>
